# Copy this file to .env.local for local testing, and add the SAME four
# variables in Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API (or "API Keys")
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Public key — safe in the browser. Either the legacy "anon" key (eyJ...)
# or the new "publishable" key (sb_publishable_...).
SUPABASE_ANON_KEY=

# SECRET — server only, never share. Either the legacy "service_role" key
# (eyJ...) or the new "secret" key (sb_secret_...).
SUPABASE_SERVICE_ROLE_KEY=

# The password the organiser types on /organiser to go live.
# Make it long; anyone with it can change what spectators see.
ORGANISER_PUBLISH_KEY=

# Optional: change only if you run more than one draft from one database.
# KFL_EVENT_ID=kfl-south
